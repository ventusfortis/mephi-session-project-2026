    1  export PAGER=cat SYSTEMD_PAGER=cat
    2  nmcli con mod ens18 ipv4.method auto
    3  nmcli -f ipv4.method,IP4.ADDRESS,IP4.GATEWAY con show ens18
    4  hostnamectl set-hostname mephi-2026.domain.local
    5  hostnamectl hostname
    6  ping -c 4 8.8.8.8 > ~/ping.out
    7  cat ~/ping.out
    8  dnf -y update
    9  dnf -y install nginx libcap-ng-utils
   10  rpm -q nginx libcap-ng-utils
   11  dnf download tcpdump --destdir /tmp
