   20  mkdir -p /data/mephi-2026
   21  groupadd -g 4444 curators
   22  groupadd -g 5500 developers
   23  useradd -u 5501 -G developers user1
   24  useradd -u 5502 -G developers user2
   25  useradd -u 5503 -G developers user3
   26  useradd -G curators curator1
   27  useradd -G curators curator2
   28  echo 'user1:MephiDev2026!!' | chpasswd
   29  echo 'user2:MephiDev2026!!' | chpasswd
   30  echo 'user3:MephiDev2026!!' | chpasswd
   31  echo 'curator1:MephiCurator2026!' | chpasswd
   32  echo 'curator2:MephiCurator2026!' | chpasswd
   33  id user1 user2 user3 curator1 curator2
   34  chown root:developers /data/mephi-2026
   35  chmod 2770 /data/mephi-2026
   36  setfacl -m g:developers:rwx,g:curators:r-x,o::--- /data/mephi-2026
   37  setfacl -d -m u::rwx,g::rwx,g:developers:rwx,g:curators:r-x,o::--- /data/mephi-2026
   38  getfacl /data/mephi-2026
   39  sudo -u user1 bash -c 'echo "created by user1" > /data/mephi-2026/file-user1.txt'
   40  sudo -u user2 bash -c 'echo "appended by user2" >> /data/mephi-2026/file-user1.txt; cat /data/mephi-2026/file-user1.txt'
   41  sudo -u user3 mkdir /data/mephi-2026/dir-user3
   42  sudo -u user1 touch /data/mephi-2026/dir-user3/file-in-dir
   43  sudo -u curator1 cat /data/mephi-2026/file-user1.txt
   44  sudo -u curator1 bash -c 'echo "curator write" >> /data/mephi-2026/file-user1.txt'
   45  sudo -u curator2 ls -l /data/mephi-2026/
   46  sudo -u nobody ls /data/mephi-2026/
   47  getfacl /data/mephi-2026/file-user1.txt
   48  ls -l /usr/sbin/tcpdump
   49  getcap /usr/sbin/tcpdump
   50  sudo -u user1 tcpdump -c 1 -i ens18 2>&1 | head -n 2
   51  setcap cap_net_raw,cap_net_admin=eip /usr/sbin/tcpdump
   52  getcap /usr/sbin/tcpdump
   53  sudo -u user1 timeout 15 tcpdump -c 3 -nn -i ens18 2>&1 | tail -n 5
   54  printf '# Кураторам проекта запрещён локальный вход в систему\n- : curators : ALL\n' > /etc/security/access-console.conf
   55  cat /etc/security/access-console.conf
   56  sed -i '/^account[[:space:]]*required[[:space:]]*pam_nologin.so/a account    required     pam_access.so accessfile=/etc/security/access-console.conf' /etc/pam.d/login /etc/pam.d/sddm
   57  grep -n pam_access /etc/pam.d/login /etc/pam.d/sddm
   58  python3 ~/pam-check.py login curator1 'MephiCurator2026!'
   59  python3 ~/pam-check.py login user1 'MephiDev2026!!'
   60  python3 ~/pam-check.py sddm curator2 'MephiCurator2026!'
   61  sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS\t90/' /etc/login.defs
   62  grep -E '^PASS_(MAX|MIN)_DAYS' /etc/login.defs
   63  for u in user1 user2 user3 curator1 curator2; do chage -M 90 $u; done
   64  chage -l user1
   65  sed -i 's/^# minlen = 8/minlen = 12/' /etc/security/pwquality.conf
   66  grep -nE '^minlen' /etc/security/pwquality.conf
   67  echo 'Short1!' | pwscore
   68  echo 'MephiDev2026!!' | pwscore
   69  export PAGER=cat SYSTEMD_PAGER=cat
   70  rm -f /tmp/tcpdump-*.i686.rpm
   71  rpm -ivh /tmp/tcpdump-*.x86_64.rpm
   72  rpm -qi tcpdump | head -n 3
