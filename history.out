   74  ls -l /usr/sbin/tcpdump
   75  getcap /usr/sbin/tcpdump
   76  sudo -u user1 tcpdump -c 1 -i ens18 2>&1 | head -n 2
   77  setcap cap_net_raw,cap_net_admin=eip /usr/sbin/tcpdump
   78  getcap /usr/sbin/tcpdump
   79  sudo -u user1 timeout 15 tcpdump -c 3 -nn -i ens18 2>&1 | tail -n 5
   80  export PAGER=cat SYSTEMD_PAGER=cat
